{
  "name": "Title changer",
  "description": "Hider extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "content.js"
  },
  "host_permissions": [
    "<all-urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls"],
      "js": ["content.js"]
    }
  ]
}
